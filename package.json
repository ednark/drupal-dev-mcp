{
  "name": "drupal-dev-mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @drupal-dev-mcp/knowledge && npm run build -w @drupal-dev-mcp/server && npm run build -w @drupal-dev-mcp/agent",
    "start": "npm run mcp:start",
    "dev": "npm run dev --workspace @drupal-dev-mcp/server",
    "mcp:start": "npm run start --workspace @drupal-dev-mcp/server",
    "agent:ask": "npm run ask --workspace @drupal-dev-mcp/agent --",
    "agent:research": "npm run research --workspace @drupal-dev-mcp/agent --",
    "index:fetch": "npm run index:fetch --workspace @drupal-dev-mcp/knowledge --",
    "index:build": "npm run index:build --workspace @drupal-dev-mcp/knowledge --",
    "index:verify": "npm run index:verify --workspace @drupal-dev-mcp/knowledge --",
    "index:rebuild": "npm run index:rebuild --workspace @drupal-dev-mcp/knowledge --",
    "index:status": "npm run index:status --workspace @drupal-dev-mcp/knowledge --",
    "sync:sources": "bash scripts/sync-docs.sh",
    "fetch:tutorials": "bash scripts/fetch-tutorials.sh",
    "fetch:docset": "bash scripts/fetch-drupal-docset.sh",
    "fetch:symfony-docs": "bash scripts/fetch-symfony-docs.sh",
    "fetch:php-manual": "bash scripts/fetch-php-manual.sh",
    "fetch:contrib-modules": "bash scripts/fetch-contrib-modules.sh",
    "fetch:certification-docs": "bash scripts/fetch-certification-docs.sh",
    "fetch:api-drupal-org": "bash scripts/fetch-api-drupal-org.sh",
    "fetch:best-practices": "bash scripts/fetch-best-practices.sh",
    "fetch:drupal-examples": "bash scripts/fetch-drupal-examples.sh",
    "fetch:contrib-module-handbook": "npx tsx scripts/fetch-contrib-module-handbook.ts",
    "fetch:drupal-module-handbook": "npx tsx scripts/fetch-drupal-module-handbook.ts",
    "fetch:drupal-skills": "bash scripts/fetch-drupal-skills.sh",
    "etl": "npx tsx etl/run.ts",
    "etl:best-practices": "npx tsx etl/run-best-practices-only.ts",
    "etl:drupal-core-docs": "npx tsx etl/run.ts",
    "etl:drupal-core-docs:dry-run": "npx tsx etl/run.ts --dry-run",
    "etl:tutorials": "npx tsx etl/run.ts",
    "etl:contrib-module-handbook": "npx tsx etl/run-contrib-module-handbook-only.ts",
    "etl:drupal-module-handbook": "npx tsx etl/run-drupal-module-handbook-only.ts",
    "etl:drupal-skills": "npx tsx etl/run-drupal-skills-only.ts",
    "verify:developer-guides": "npx tsx etl/verify-developer-guides.ts",
    "verify:tutorials": "npx tsx etl/verify-tutorials.ts",
    "verify:docset": "npx tsx etl/verify-docset.ts",
    "verify:symfony-docs": "npx tsx etl/verify-symfony.ts",
    "verify:php-manual": "npx tsx etl/verify-php-manual.ts",
    "verify:contrib-modules": "npx tsx etl/verify-contrib-modules.ts",
    "verify:certification-docs": "npx tsx etl/verify-certification-docs.ts",
    "verify:api-drupal-org": "npx tsx etl/verify-api-drupal-org.ts",
    "verify:contrib-module-handbook": "npx tsx etl/verify-contrib-module-handbook.ts",
    "verify:drupal-module-handbook": "npx tsx etl/verify-drupal-module-handbook.ts",
    "research:sources": "npx tsx scripts/research-sources.ts",
    "research:tools": "npx tsx scripts/research-tools.ts",
    "test:research-tools": "npx tsx tests/research-tools-smoke.ts",
    "test:research-sources": "npx tsx tests/research-sources-smoke.ts",
    "typecheck:legacy": "tsc -p tsconfig.typecheck.json",
    "typecheck": "npm run typecheck -w @drupal-dev-mcp/knowledge && npm run build -w @drupal-dev-mcp/knowledge && npm run typecheck -w @drupal-dev-mcp/server && npm run typecheck -w @drupal-dev-mcp/agent",
    "test:legacy": "node --import tsx tests/research-tools-smoke.ts && node --import tsx tests/research-sources-smoke.ts",
    "test": "node --import tsx --test packages/*/tests/*.test.ts"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.14.0",
    "@langchain/textsplitters": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.8.0",
    "apache-arrow": "^18.0.0",
    "better-sqlite3": "^9.4.0",
    "commander": "^12.1.0",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.0",
    "openai": "^4.77.0",
    "php-parser": "^3.7.0",
    "p-limit": "^5.0.0",
    "playwright": "^1.58.2",
    "playwright-extra": "^4.3.6",
    "puppeteer": "^24.7.1",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "tiktoken": "^1.0.17",
    "yaml": "^2.8.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
