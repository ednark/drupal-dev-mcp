{
  "name": "drupal-dev-mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @drupal-dev-mcp/knowledge && npm run build -w @drupal-dev-mcp/server && npm run build -w @drupal-dev-mcp/agent",
    "start": "npm run mcp:start",
    "dev": "npm run dev --workspace @drupal-dev-mcp/server",
    "mcp:start": "npm run start --workspace @drupal-dev-mcp/server",
    "agent:ask": "npm run ask --workspace @drupal-dev-mcp/agent --",
    "agent:research": "npm run research --workspace @drupal-dev-mcp/agent --",
    "index:fetch": "npm run index:fetch --workspace @drupal-dev-mcp/knowledge --",
    "index:fetch-tutorials": "tsx scripts/fetch-drupal-tutorial-articles.ts",
    "index:fetch-certification": "tsx scripts/fetch-certification-study-guides-jina.ts",
    "index:fetch-questions": "tsx scripts/fetch-community-questions.ts",
    "index:curate-questions": "tsx scripts/curate-community-questions.ts",
    "index:audit-questions": "tsx scripts/audit-community-questions.ts",
    "index:build": "npm run index:build --workspace @drupal-dev-mcp/knowledge --",
    "index:verify": "npm run index:verify --workspace @drupal-dev-mcp/knowledge --",
    "index:rebuild": "npm run index:rebuild --workspace @drupal-dev-mcp/knowledge --",
    "index:status": "npm run index:status --workspace @drupal-dev-mcp/knowledge --",
    "index:freshness": "npm run index:freshness --workspace @drupal-dev-mcp/knowledge --",
    "index:benchmark": "npm run index:benchmark --workspace @drupal-dev-mcp/knowledge --",
    "typecheck": "npm run typecheck -w @drupal-dev-mcp/knowledge && npm run build -w @drupal-dev-mcp/knowledge && npm run typecheck -w @drupal-dev-mcp/server && npm run typecheck -w @drupal-dev-mcp/agent",
    "test": "node --import tsx --test packages/*/tests/*.test.ts",
    "pretest": "node scripts/doctor-node-abi.mjs",
    "check": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
