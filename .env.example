# ─── Required ─────────────────────────────────────────────────────────────────
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ─── Optional: override the synthesis model (default: gpt-4o) ─────────────────
# Use gpt-4o-mini for cheaper development testing (~$0.001/question vs ~$0.02)
OPENAI_SYNTHESIS_MODEL=gpt-4o

# ─── Data paths (defaults shown — change only if you move the data directory) ─
LANCEDB_PATH=./data/lancedb
ETL_SOURCES_DIR=./data/sources

# ─── ETL settings ─────────────────────────────────────────────────────────────
ETL_DRUPAL_CORE_BRANCH=11.x

# ─── Logging ──────────────────────────────────────────────────────────────────
# Options: error, warn, info, debug
LOG_LEVEL=info
