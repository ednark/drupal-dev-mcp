# ─── Copy this file to .env and fill in your real values ─────────────────────
# Never commit the .env file — it is intentionally excluded by .gitignore.

# =============================================================================
# OPTIONAL OPENAI PROVIDER
# =============================================================================

# OpenAI API key. The MCP server and lexical knowledge queries do not need it.
# It is required for the optional agent and for explicitly requested embeddings.
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# OPENAI MODEL OVERRIDES
# =============================================================================

# Model used by the agent package for answers, follow-up queries, and reports.
OPENAI_AGENT_MODEL=gpt-4o-mini

# Model used only by `index:build -- --with-embeddings`.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# =============================================================================
# INDEX PATH
# =============================================================================

# Optional override for generated builds, active.json, and embedding cache.
# DRUPAL_MCP_INDEX_ROOT=/absolute/path/to/drupal-dev-mcp/data/index

# =============================================================================
# LEGACY SOURCE-IMPORT HELPERS
# =============================================================================

# The 0.2 index fetcher pins Drupal core to 10.6.x and 11.4.x. Variables below
# apply only to retained source-import helper scripts, not the MCP runtime.

# Override the Drupal docset download URL (used by scripts/fetch-drupal-docset.sh).
# Default points to the official Kapeli feed.
DRUPAL_DOCSET_URL=https://kapeli.com/feeds/Drupal.tgz

# Optional: absolute path to a private directory containing proprietary
# certification / training documents (PDFs, EPUBs, Markdown).
# If set, scripts/fetch-certification-docs.sh imports files from this path.
# Leave unset if you have no private training materials.
# TRAINING_DOCS_PATH=/path/to/your/private/training-docs

# Set to "true" to skip ePub download/conversion in scripts/sync-docs.sh.
# Useful in CI environments without pandoc installed.
SKIP_EPUB=false

# =============================================================================
# PLAYWRIGHT  (optional — used by browser-based fetch scripts)
# =============================================================================

# Set to "true" to launch Chromium in headless mode when using stealth-browser
# or the certification-docs-playwright fetch scripts.
PLAYWRIGHT_HEADLESS=true

# Set to "1" to allow the Wayback-based certification fetch script to fall
# back to a live Playwright browser when no Wayback snapshot is available.
ENABLE_PLAYWRIGHT_FALLBACK=0

# Maximum number of retry attempts per page when using the Playwright fetcher.
PLAYWRIGHT_MAX_RETRIES=2

# =============================================================================
# LOGGING / DEBUGGING  (optional — defaults shown)
# =============================================================================

# Log verbosity. Options: error | warn | info | debug
LOG_LEVEL=info

# Set to "true" to print verbose query diagnostics to stderr.
DEBUG_QUERIES=false
