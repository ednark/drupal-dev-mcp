# ─── Copy this file to .env and fill in your real values ─────────────────────
# Never commit the .env file — it is intentionally excluded by .gitignore.

# =============================================================================
# REQUIRED
# =============================================================================

# OpenAI API key. Needed for embeddings (text-embedding-3-small) and all
# chat-based synthesis and research features.
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# OPENAI MODEL OVERRIDES  (optional — sensible defaults shown)
# =============================================================================

# Model used for answer synthesis in ask-drupal-expert and run-test-questions.
# Switch to gpt-4o-mini for cheaper dev/test runs (~$0.001/question vs ~$0.02).
OPENAI_SYNTHESIS_MODEL=gpt-4o

# Model used for iterative deep-research planning (deep_research_drupal tool).
OPENAI_RESEARCH_MODEL=gpt-4o

# Model used by the research-sources maintenance script to produce summaries.
RESEARCH_SOURCES_SUMMARY_MODEL=gpt-4o-mini

# Model used by the research-tools maintenance script to produce summaries.
RESEARCH_TOOLS_SUMMARY_MODEL=gpt-4o-mini

# =============================================================================
# DATA PATHS  (optional — defaults shown, change only if you rearrange the repo)
# =============================================================================

# Directory where LanceDB stores its vector database files.
LANCEDB_PATH=./data/lancedb

# Root directory where fetch scripts write downloaded source documents.
ETL_SOURCES_DIR=./data/sources

# =============================================================================
# ETL SETTINGS  (optional — defaults shown)
# =============================================================================

# Drupal core git branch to clone/update during sync-docs.sh.
ETL_DRUPAL_CORE_BRANCH=11.x

# Override the Drupal docset download URL (used by scripts/fetch-drupal-docset.sh).
# Default points to the official Kapeli feed.
DRUPAL_DOCSET_URL=https://kapeli.com/feeds/Drupal.tgz

# Optional: absolute path to a private directory containing proprietary
# certification / training documents (PDFs, EPUBs, Markdown).
# If set, scripts/fetch-certification-docs.sh imports files from this path.
# Leave unset if you have no private training materials.
# TRAINING_DOCS_PATH=/path/to/your/private/training-docs

# Set to "true" to skip ePub download/conversion in scripts/sync-docs.sh.
# Useful in CI environments without pandoc installed.
SKIP_EPUB=false

# =============================================================================
# PLAYWRIGHT  (optional — used by browser-based fetch scripts)
# =============================================================================

# Set to "true" to launch Chromium in headless mode when using stealth-browser
# or the certification-docs-playwright fetch scripts.
PLAYWRIGHT_HEADLESS=true

# Set to "1" to allow the Wayback-based certification fetch script to fall
# back to a live Playwright browser when no Wayback snapshot is available.
ENABLE_PLAYWRIGHT_FALLBACK=0

# Maximum number of retry attempts per page when using the Playwright fetcher.
PLAYWRIGHT_MAX_RETRIES=2

# =============================================================================
# LOGGING / DEBUGGING  (optional — defaults shown)
# =============================================================================

# Log verbosity. Options: error | warn | info | debug
LOG_LEVEL=info

# Set to "true" to print verbose query diagnostics to stderr.
DEBUG_QUERIES=false
