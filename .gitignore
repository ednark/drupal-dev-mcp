# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/

# ─── Build output ────────────────────────────────────────────────────────────
# packages/* emit into packages/*/dist (covered by the bare pattern).
dist/
build/
*.tsbuildinfo

# ─── Environment variables ───────────────────────────────────────────────────
# Copy .env.example → .env and fill in your real values; never commit .env
.env
!.env.example

# ─── Data directories ────────────────────────────────────────────────────────
# These are auto-generated by the ETL pipeline and can be very large.
# Run the ETL pipeline locally to populate them (see README).

# LanceDB vector database (populated by ETL)
data/lancedb/**
!data/lancedb/.gitkeep

# Downloaded/scraped source documents (populated by fetch scripts)
data/sources/**
# Exception: the curated placement-guidance corpus is hand-authored, not
# fetched — it must survive data/sources rebuilds, so it is version-controlled.
!data/sources/drupal-placement-guidance/
!data/sources/drupal-placement-guidance/**
!data/sources/.gitkeep

# Runtime cache files
data/cache/**
!data/cache/.gitkeep

# Versioned knowledge-index builds and atomic activation manifest.
data/index/**
!data/index/.gitkeep

# ─── Database files ──────────────────────────────────────────────────────────
*.sqlite
*.db
*.lance

# ─── Log files ───────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── OS-specific files ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ─── Editor/IDE files ────────────────────────────────────────────────────────
# Exclude personal settings; keep shared workspace settings if added intentionally
.idea/
.vscode/settings.json
.vscode/launch.json
.vscode/*.code-snippets

# ─── Temporary / scratch files ───────────────────────────────────────────────
*.tmp
*.bak
tmp/

# ─── Package/download archives ───────────────────────────────────────────────
# Downloaded by shell scripts in scripts/ (docsets, PHP manual, etc.)
*.tgz
*.tar.gz
*.zip

# ─── Playwright session data (contains cookies/auth tokens) ──────────────────
playwright-storage-state.json
