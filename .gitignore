# Dependencies
node_modules/

# Build output
dist/
build/

# Environment variables — copy .env.example to .env and fill in real values
.env

# ─── Data directories ────────────────────────────────────────────────────────
# These are auto-generated by the ETL pipeline and can be very large.
# Run the ETL pipeline locally to populate them (see README).

# LanceDB vector database (populated by ETL)
data/lancedb/**
!data/lancedb/.gitkeep

# Downloaded/scraped source documents (populated by fetch scripts)
data/sources/**
!data/sources/.gitkeep

# Runtime cache files
data/cache/**
!data/cache/.gitkeep

# ─── Log files ───────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── OS-specific files ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ─── Editor/IDE files ────────────────────────────────────────────────────────
.idea/
.vscode/settings.json

# ─── Package archives ────────────────────────────────────────────────────────
*.tgz
*.tar.gz

# ─── LanceDB binary data format ──────────────────────────────────────────────
*.lance

# ─── Browser session data (contains cookies/auth tokens) ─────────────────────
playwright-storage-state.json
