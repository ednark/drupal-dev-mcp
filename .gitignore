# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/

# ─── Build output ────────────────────────────────────────────────────────────
dist/
build/

# ─── Compiled TypeScript output ──────────────────────────────────────────────
# These are emitted by tsc from the src/, etl/, scripts/, and tests/ trees.
# Root-level *.js files (e.g. jest.config.js, eslint.config.js) are NOT excluded.
src/**/*.js
src/**/*.d.ts
etl/**/*.js
etl/**/*.d.ts
scripts/**/*.js
scripts/**/*.d.ts
tests/**/*.js
tests/**/*.d.ts

# ─── Environment variables ───────────────────────────────────────────────────
# Copy .env.example → .env and fill in your real values; never commit .env
.env
!.env.example

# ─── Data directories ────────────────────────────────────────────────────────
# These are auto-generated by the ETL pipeline and can be very large.
# Run the ETL pipeline locally to populate them (see README).

# LanceDB vector database (populated by ETL)
data/lancedb/**
!data/lancedb/.gitkeep

# Downloaded/scraped source documents (populated by fetch scripts)
data/sources/**
!data/sources/.gitkeep

# Runtime cache files
data/cache/**
!data/cache/.gitkeep

# ─── Database files ──────────────────────────────────────────────────────────
*.sqlite
*.db
*.lance

# ─── Log files ───────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── OS-specific files ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ─── Editor/IDE files ────────────────────────────────────────────────────────
# Exclude personal settings; keep shared workspace settings if added intentionally
.idea/
.vscode/settings.json
.vscode/launch.json
.vscode/*.code-snippets

# ─── Temporary / scratch files ───────────────────────────────────────────────
*.tmp
*.bak
tmp/

# ─── Package/download archives ───────────────────────────────────────────────
# Downloaded by shell scripts in scripts/ (docsets, PHP manual, etc.)
*.tgz
*.tar.gz
*.zip

# ─── Playwright session data (contains cookies/auth tokens) ──────────────────
playwright-storage-state.json
