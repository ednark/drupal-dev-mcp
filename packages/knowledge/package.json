    "index:verify": "tsx src/cli.ts verify",
    "index:rebuild": "tsx src/cli.ts rebuild",
    "index:status": "tsx src/cli.ts status",
    "index:benchmark": "tsx src/cli.ts benchmark"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.14.0",
    "better-sqlite3": "^9.4.0",
    "dotenv": "^16.4.7",
    "openai": "^4.77.0",
    "php-parser": "^3.7.0",
    "yaml": "^2.8.1"
  }
}
